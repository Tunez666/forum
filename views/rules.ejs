<%- include('partials/head') %>

<body>
  <div class="bg-layer">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
    <div class="grid-lines"></div>
  </div>

  <%- include('partials/header') %>

  <main class="main rules-page">

    <!-- Hero -->
    <section class="hero rules-hero">
      <div class="hero-content">

        <h1 class="hero-title">
          <span class="glitch" data-text="Правила">Правила</span><br>
          форума
        </h1>

        <p class="hero-desc">
          Чтобы сообщество оставалось дружелюбным, полезным и комфортным
          для всех участников.
        </p>
      </div>

      <div class="hero-visual">
        <div class="hero-card floating">
          <div class="rules-symbol">⚖️</div>
        </div>
      </div>
    </section>

    <!-- Rules -->
    <section class="rules-grid">

      <div class="rule-card">
        <div class="rule-number">01</div>
        <h3>Уважайте участников</h3>
        <p>
          Оскорбления, травля, токсичное поведение и унижения запрещены.
          Спорьте по теме, а не переходите на личности.
        </p>
      </div>

      <div class="rule-card">
        <div class="rule-number">02</div>
        <h3>Без спама</h3>
        <p>
          Запрещены флуд, бессмысленные сообщения, массовое дублирование
          тем и навязчивая реклама.
        </p>
      </div>

      <div class="rule-card">
        <div class="rule-number">03</div>
        <h3>Только релевантный контент</h3>
        <p>
          Публикуйте сообщения в подходящих разделах.
          Оффтоп может быть удалён модерацией.
        </p>
      </div>

      <div class="rule-card">
        <div class="rule-number">04</div>
        <h3>Запрещён вредоносный контент</h3>
        <p>
          Никаких вирусов, подозрительных ссылок, фишинга
          и попыток получить чужие данные.
        </p>
      </div>

      <div class="rule-card">
        <div class="rule-number">05</div>
        <h3>Не нарушайте закон</h3>
        <p>
          Контент, нарушающий законодательство, авторские права
          или распространяющий запрещённые материалы — удаляется.
        </p>
      </div>

      <div class="rule-card">
        <div class="rule-number">06</div>
        <h3>Не злоупотребляйте жалобами</h3>
        <p>
          Жалобы должны быть обоснованными.
          Массовые ложные репорты рассматриваются как нарушение.
        </p>
      </div>

    </section>

    <!-- Punishments -->
    <section class="section">
      <div class="section-header">
        <h2 class="section-title">
          <span class="title-icon">◆</span>
          Санкции
        </h2>
      </div>

        <div class="sanction-item">
          <span>Удаление сообщения</span>
          <p>За нарушение правил публикации</p>
        </div>

        <div class="sanction-item">
          <span>Перманентный бан</span>
          <p>За серьёзные или систематические нарушения</p>
        </div>
      </div>
    </section>

    <!-- Footer block -->
    <section class="rules-footer-card">
      <h2>Соблюдай правила — и путь Звёздного Экспресса будет комфортным для всех ✨</h2>
      <a href="/" class="btn btn-primary">Вернуться на главную</a>
    </section>

  </main>

  <%- include('partials/footer') %>
</body>