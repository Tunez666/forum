<%- include('../partials/head') %>

  <body class="topics-page">
    <!-- Animated Background -->
    <div class="bg-layer">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="orb orb-3"></div>
      <div class="grid-lines"></div>
    </div>

    <!-- Admin Layout -->
    <div class="admin-layout">
      <%- include('../partials/adminSidebar') %>
        <main class="admin-main">

          <header class="admin-header">
            <div class="header-left">
              <button class="sidebar-toggle" onclick="toggleSidebar()">
                ☰
              </button>

              <div class="page-title">
                <h1>Модерация форума</h1>
                <span class="page-subtitle">Управление топиками и жалобами</span>
              </div>
            </div>
          </header>

          <div class="admin-content">

            <!-- Filters -->
            <div class="topics-filters">
              <div class="filter-group">
                <label class="filter-label">Категория</label>
                <select class="filter-select" onchange="applyFilter(this)">
                  <option value="">Все категории</option>

                  <% categories.forEach(categorie=> { %>
                    <option value="<%= categorie.id %>">
                      <%= categorie.name %>
                    </option>
                    <% }) %>
                </select>
              </div>

              <div class="filter-group">
                <label class="filter-label">Фильтр</label>
                <div class="section-tabs">
                  <a href="/topics?sort=new" class="tab <%= sort === 'new' ? 'active' : '' %>">Новые</a>
                  <a href="/topics?sort=popular" class="tab <%= sort === 'popular' ? 'active' : '' %>">Популярные</a>
                  <a href="/topics?sort=empty" class="tab <%= sort === 'empty' ? 'active' : '' %>">Не популярные</a>
                </div>
              </div>
              <div class="filter-group search-group">
                <label class="filter-label">Поиск</label>
                <div class="search-input-wrapper">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                  </svg>
                  <form method="GET" action="/searchResults" class="search-form">
                    <input type="text" name="search" class="search-input" placeholder="Поиск по темам...">
                  </form>
                </div>
              </div>
            </div>
          </div>

            <!-- Tabs -->
            <section class="tabs-section">
              <button class="tab-btn active" data-tab="topics">Топики</button>
              <button class="tab-btn" data-tab="reports">Жалобы</button>
            </section>

            <!-- Search -->
            <section class="filters-section">
              <div class="search-box large">
                <input type="text" placeholder="Поиск..." class="search-input" id="global-search">
              </div>
            </section>

            <!-- TOPICS -->
            <section class="tab-content active" id="topics-tab">
              <div class="table-container">
                <table class="data-table">
                  <thead>
                    <tr>
                      <th>Тема</th>
                      <th>Автор</th>
                      <th>Категория</th>
                      <th>Дата</th>
                      <th>Действия</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% subTopics.forEach(topic=> { %>
                      <tr>
                        <td>
                          <%= topic.title %>
                        </td>
                        <td>
                          <%= topic.author %>
                        </td>
                        <td>
                          <%= topic.category %>
                        </td>
                        <td>
                          <%= topic.created_at %>
                        </td>
                        <td>
                          <button onclick="hideTopic(<%= topic.id %>)">Скрыть</button>
                          <button onclick="deleteTopic(<%= topic.id %>)">Удалить</button>
                        </td>
                      </tr>
                      <% }) %>
                  </tbody>
                </table>
              </div>
            </section>

            <!-- REPORTS -->
            <section class="tab-content" id="reports-tab">
              <div class="table-container">
                <table class="data-table">
                  <thead>
                    <tr>
                      <th>Тема</th>
                      <th>Причина</th>
                      <th>Пожаловался</th>
                      <th>Дата</th>
                      <th>Решение</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% reports.forEach(report=> { %>
                      <tr>
                        <td>
                          <%= report.topic_title %>
                        </td>
                        <td>
                          <%= report.reason %>
                        </td>
                        <td>
                          <%= report.user %>
                        </td>
                        <td>
                          <%= report.created_at %>
                        </td>
                        <td>
                          <button onclick="approveReport(<%= report.id %>)">Принять</button>
                          <button onclick="rejectReport(<%= report.id %>)">Отклонить</button>
                        </td>
                      </tr>
                      <% }) %>
                  </tbody>
                </table>
              </div>
            </section>

          </div>
        </main>
        <!-- Main Content -->
    </div>

    <!-- Toast Container -->
    <div class="toast-container" id="toast-container"></div>

    <script>

      const tabs = document.querySelectorAll('.tab-btn');
      const contents = document.querySelectorAll('.tab-content');

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          tabs.forEach(t => t.classList.remove('active'));
          contents.forEach(c => c.classList.remove('active'));

          tab.classList.add('active');

          if (tab.dataset.tab === 'topics') {
            document.getElementById('topics-tab').classList.add('active');
          } else {
            document.getElementById('reports-tab').classList.add('active');
          }
        });
      });

      // ============================================
      // Toast Notifications
      // ============================================
      function showToast(message, type = 'success') {
        const container = document.getElementById('toast-container');
        const toast = document.createElement('div');
        toast.className = `toast toast-${type}`;

        const icons = {
          success: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>',
          error: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>',
          info: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>'
        };

        toast.innerHTML = `
        <span class="toast-icon">${icons[type]}</span>
        <span class="toast-message">${message}</span>
      `;

        container.appendChild(toast);
        setTimeout(() => toast.classList.add('show'), 10);
        setTimeout(() => {
          toast.classList.remove('show');
          setTimeout(() => toast.remove(), 300);
        }, 3000);
      }

      // Закрытие модалок
      document.querySelectorAll('.modal-overlay').forEach(overlay => {
        overlay.addEventListener('click', function (e) {
          if (e.target === this) {
            this.classList.remove('active');
          }
        });
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          document.querySelectorAll('.modal-overlay.active').forEach(modal => {
            modal.classList.remove('active');
          });
        }
      });
    </script>
  </body>

  </html>