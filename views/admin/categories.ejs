<%- include('../partials/head') %>

<body class="categories-page">
  <!-- Animated Background -->
  <div class="bg-layer">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
    <div class="grid-lines"></div>
  </div>

  <!-- Admin Layout -->
  <div class="admin-layout">
    <%- include('../partials/adminSidebar') %>

    <!-- Main Content -->
    <main class="admin-main">
      <!-- Header -->
      <header class="admin-header">
        <div class="header-left">
          <button class="sidebar-toggle" onclick="toggleSidebar()">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="3" y1="12" x2="21" y2="12" />
              <line x1="3" y1="6" x2="21" y2="6" />
              <line x1="3" y1="18" x2="21" y2="18" />
            </svg>
          </button>
          <div class="page-title">
            <h1>Управление разделами</h1>
            <span class="page-subtitle">Создание и редактирование разделов форума</span>
          </div>
        </div>

        <div class="header-right">
          <a href="/" class="btn-back-site">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <polyline points="15 3 21 3 21 9" />
              <line x1="10" y1="14" x2="21" y2="3" />
            </svg>
            На сайт
          </a>

          <button class="btn btn-primary" onclick="showAddCategoryModal()">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="12" y1="5" x2="12" y2="19" />
              <line x1="5" y1="12" x2="19" y2="12" />
            </svg>
            Создать раздел
          </button>
        </div>
      </header>

      <!-- Content -->
      <div class="admin-content">
        <!-- Stats Cards -->
        <section class="stats-row">
          <div class="stat-card">
            <div class="stat-icon cyan">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
              </svg>
            </div>
            <div class="stat-info">
              <span class="stat-value"><%= categoriesCount %></span>
              <span class="stat-label">Всего разделов</span>
            </div>
          </div>

          <div class="stat-card">
            <div class="stat-icon purple">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
              </svg>
            </div>
            <div class="stat-info">
              <span class="stat-value"><%= topicsCount %></span>
              <span class="stat-label">Тем в разделах</span>
            </div>
          </div>

          <div class="stat-card">
            <div class="stat-icon pink">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
              </svg>
            </div>
            <div class="stat-info">
              <span class="stat-value"><%= moderCount %></span>
              <span class="stat-label">Модераторов</span>
            </div>
          </div>
        </section>

        <!-- Categories List -->
        <section class="data-section">
          <div class="section-header">
            <div class="section-title-group">
              <h2>Список Разделов</h2>
              <span class="section-count"><%= parentsCount %> Родительских разделов</span>
            </div>
          </div>

          <!-- Category Blocks: ОДИН блок на КАЖДЫЙ родительский раздел (parent_id IS NULL) -->
          <div class="category-blocks" id="categories-container">
            <% parents.forEach(categorie => { %>
              <%
                // дочерние разделы текущего родителя (со статистикой)
                const children = categorie.children || [];
              %>
              <!-- ROOT CATEGORY BLOCK -->
              <div class="category-block" data-category-id="<%= categorie.id %>">

                <!-- Parent header row -->
                <div class="category-parent-row">
                  <div class="category-parent-info">
                    <div class="category-icon-wrapper" style="--category-color: #06d6d6;">
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
                      </svg>
                    </div>
                    <div class="category-parent-text">
                      <h3 class="category-name"><%= categorie.name %></h3>
                      <p class="category-description"><%= categorie.description %></p>
                    </div>
                  </div>

                  <div class="category-parent-meta">
                    <div class="category-stats">
                      <div class="category-stat">
                        <span class="stat-num"><%= categorie.topics_count %></span>
                        <span class="stat-lbl">Тем</span>
                      </div>
                      <div class="category-stat">
                        <span class="stat-num"><%= categorie.posts_count %></span>
                        <span class="stat-lbl">Постов</span>
                      </div>
                    </div>

                    <div class="category-actions-dropdown">
                      <button class="dropdown-trigger" onclick="toggleDropdown(event, this)">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <circle cx="12" cy="12" r="1" />
                          <circle cx="12" cy="5" r="1" />
                          <circle cx="12" cy="19" r="1" />
                        </svg>
                      </button>
                      <div class="dropdown-menu">
                        <button onclick="editCategoryOpen('<%= categorie.id %>', '<%= categorie.name %>', '<%= categorie.description %>', '<%= categorie.parent_id %>')">
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                          </svg>
                          Редактировать
                        </button>
                        <button class="danger" onclick="openDeleteCategoryModal('<%= categorie.id %>')">
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="3 6 5 6 21 6" />
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                          </svg>
                          Удалить
                        </button>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- CHILDREN -->
                <% if (children.length) { %>
                  <div class="category-children">
                    <div class="children-title">Дочерние разделы</div>

                    <div class="children-list">
                      <% children.forEach(child => { %>
                        <div class="child-row" data-category-id="<%= child.id %>">
                          <a href="/dagTopics/<%= child.id %>" class="child-main">
                            <span class="child-line">└</span>
                            <span class="child-name"><%= child.name %></span>
                          </a>

                          <div class="child-meta">
                            <div class="category-stats">
                              <div class="category-stat">
                                <span class="stat-num"><%= child.topics_count %></span>
                                <span class="stat-lbl">Тем</span>
                              </div>
                              <div class="category-stat">
                                <span class="stat-num"><%= child.posts_count %></span>
                                <span class="stat-lbl">Постов</span>
                              </div>
                            </div>

                            <div class="category-actions-dropdown">
                              <button class="dropdown-trigger" onclick="toggleDropdown(event, this)">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                  <circle cx="12" cy="12" r="1" />
                                  <circle cx="12" cy="5" r="1" />
                                  <circle cx="12" cy="19" r="1" />
                                </svg>
                              </button>
                              <div class="dropdown-menu">
                                <button onclick="editCategoryOpen('<%= child.id %>', '<%= child.name %>', '<%= child.description %>', '<%= child.parent_id %>')">
                                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                                  </svg>
                                  Редактировать
                                </button>
                                <button class="danger" onclick="openDeleteCategoryModal('<%= child.id %>')">
                                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="3 6 5 6 21 6" />
                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                  </svg>
                                  Удалить
                                </button>
                              </div>
                            </div>
                          </div>
                        </div>
                      <% }) %>
                    </div>
                  </div>
                <% } else { %>
                  <div class="category-children">
                    <div class="children-empty">Нет дочерних разделов</div>
                  </div>
                <% } %>

              </div>
              <!-- /ROOT CATEGORY BLOCK -->
            <% }) %>
          </div>

          <!-- Pagination -->
          <div class="reports-pagination">
            <% if (page > 1) { %>
              <a href="?page=<%= page - 1 %>" class="reports-pagination__link reports-pagination__arrow">←</a>
            <% } %>

            <% for (let i = 1; i <= pages; i++) { %>
              <a href="?page=<%= i %>" class="reports-pagination__link <%= page === i ? 'reports-pagination__link--active' : '' %>"><%= i %></a>
            <% } %>

            <% if (page < pages) { %>
              <a href="?page=<%= page + 1 %>" class="reports-pagination__link reports-pagination__arrow">→</a>
            <% } %>
          </div>
        </section>
      </div>
    </main>
  </div>

  <!-- Add Category Modal -->
  <div class="modal-overlay" id="category-modal">
    <div class="modal-content modal-lg">
      <div class="modal-header">
        <h3 id="modal-title">Создать раздел</h3>
        <button class="modal-close" onclick="closeCategoryModal()">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>
      </div>

      <form id="category-form" method='POST' action='/admin/modalAddCategories'>
        <input type="hidden" id="category-id" name="id">

        <div class="modal-body">
          <div class="form-group">
            <label for="category-name">Название раздела *</label>
            <input type="text" id="category-name" name="name" class="form-input"
              placeholder="Например: Общее обсуждение" required>
          </div>

          <div class="form-group">
            <label for="category-description">Описание</label>
            <textarea id="category-description" name="description" class="form-textarea"
              placeholder="Краткое описание категории..." rows="3"></textarea>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="category-parent-add">Родительская категория</label>
              <select id="category-parent-add" name="parent_id" class="form-input">
                <option value="">Нет (корневая)</option>
                <% allParents.forEach(parent => { %>
                  <option value="<%= parent.id %>"><%= parent.name %></option>
                <% }) %>
              </select>
            </div>
          </div>
        </div>

        <div class="modal-footer">
          <button type="submit" class="btn btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" />
              <polyline points="17 21 17 13 7 13 7 21" />
              <polyline points="7 3 7 8 15 8" />
            </svg>
            Сохранить
          </button>
          <button type="button" class="btn btn-secondary" onclick="closeCategoryModal()">Отмена</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Edit Category Modal -->
  <div class="modal-overlay" id="edit-category-modal">
    <div class="modal-content modal-lg">
      <div class="modal-header">
        <h3 id="modal-title">Редактировать категорию</h3>
        <button class="modal-close" onclick="closeEditCategoryModal()">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>
      </div>

      <form id="edit-category-form" method='POST' action='/admin/modalEditCategories'>
        <input type="hidden" id="edit-category-id" name="id">

        <div class="modal-body">
          <div class="form-group">
            <label for="edit-category-name">Название:</label>
            <input type="text" id="edit-category-name" name="name" class="form-input">
          </div>

          <div class="form-group">
            <label for="edit-category-description">Описание:</label>
            <textarea id="edit-category-description" name="description" class="form-textarea" rows="4"></textarea>
          </div>

          <div class="form-group">
            <label for="category-parent-edit">Сменить родительскую категорию</label>
            <select id="category-parent-edit" name="parent_id" class="form-input">
              <option value="">Нет (корневая)</option>
              <% allParents.forEach(parent => { %>
                <option value="<%= parent.id %>"><%= parent.name %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <div class="modal-footer">
          <button type="submit" class="btn btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" />
              <polyline points="17 21 17 13 7 13 7 21" />
              <polyline points="7 3 7 8 15 8" />
            </svg>
            Сохранить
          </button>
          <button type="button" class="btn btn-secondary" onclick="closeEditCategoryModal()">Отмена</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Delete Category Modal -->
  <div class="modal-overlay" id="delete-category-modal" onclick="closeModalOnOverlayDelete(event)">
    <div class="modal-content">
      <div class="modal-header">
        <h3>Удаление категории</h3>
        <button class="modal-close" onclick="closeDeleteCategoryModal()">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>
      </div>

      <form method="POST" action="/admin/modalDeleteCategory">
        <input type="hidden" id="delete-category-id" name="id">

        <p style="margin-bottom: 20px;">Вы уверены, что хотите удалить категорию?</p>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12" />
            </svg>
            Удалить
          </button>
          <button type="button" class="btn btn-secondary" onclick="closeDeleteCategoryModal()">Отмена</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    // ============================================
    // Dropdown Menu
    // ============================================
    function toggleDropdown(event, button) {
      event.stopPropagation();

      const dropdown = button.closest('.category-actions-dropdown');
      const isOpen = dropdown.classList.contains('open');

      // Закрыть все другие dropdown
      document.querySelectorAll('.category-actions-dropdown.open').forEach(d => {
        d.classList.remove('open');
      });

      // Если не было открыто - открыть
      if (!isOpen) {
        dropdown.classList.add('open');
      }
    }

    // Закрытие при клике вне dropdown
    document.addEventListener('click', function (e) {
      if (!e.target.closest('.category-actions-dropdown')) {
        document.querySelectorAll('.category-actions-dropdown.open').forEach(d => {
          d.classList.remove('open');
        });
      }
    });

    // ============================================
    // Add Category Modal
    // ============================================
    function showAddCategoryModal() {
      document.getElementById('category-form').reset();
      document.getElementById('category-modal').classList.add('active');
    }

    function closeCategoryModal() {
      document.getElementById('category-modal').classList.remove('active');
    }

    // ============================================
    // Edit Category Modal
    // ============================================
    function editCategoryOpen(id, name, description, parentId) {
      try {
        document.getElementById('edit-category-id').value = id;
        document.getElementById('edit-category-name').value = name || '';
        document.getElementById('edit-category-description').value = description || '';

        // нормализация и установка текущего родителя в select
        const pid = parentId && parentId !== 'null' && parentId !== '0' ? String(parentId) : '';
        const select = document.getElementById('category-parent-edit');
        if (select) select.value = pid;

        document.getElementById('edit-category-modal').classList.add('active');
      } catch (err) {
        console.error('editCategoryOpen error:', err);
      }
    }

    function closeEditCategoryModal() {
      document.getElementById('edit-category-modal').classList.remove('active');
    }

    // ============================================
    // Delete Category Modal
    // ============================================
    function openDeleteCategoryModal(id) {
      document.getElementById('delete-category-id').value = id;
      document.getElementById('delete-category-modal').classList.add('active');
    }

    function closeDeleteCategoryModal() {
      document.getElementById('delete-category-modal').classList.remove('active');
    }

    function closeModalOnOverlayDelete(event) {
      if (event.target.id === 'delete-category-modal') {
        closeDeleteCategoryModal();
      }
    }

    // ============================================
    // Закрытие модалок по клику на оверлей
    // ============================================
    document.querySelectorAll('.modal-overlay').forEach(overlay => {
      overlay.addEventListener('click', function (e) {
        if (e.target === this) {
          this.classList.remove('active');
        }
      });
    });

    // Закрытие модалок по Escape
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        document.querySelectorAll('.modal-overlay.active').forEach(modal => {
          modal.classList.remove('active');
        });
      }
    });
  </script>
</body>

</html>
