<%- include('../partials/head') %>

    <body>
        <!-- Animated Background -->

        <header class="admin-header">
            <div class="header-left">
                <button class="sidebar-toggle" onclick="toggleSidebar()">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="3" y1="12" x2="21" y2="12" />
                        <line x1="3" y1="6" x2="21" y2="6" />
                        <line x1="3" y1="18" x2="21" y2="18" />
                    </svg>
                </button>

                <div class="page-title">
                    <h1>Модерация пользователей</h1>
                    <span class="page-subtitle">Управление ролями и блокировками</span>
                </div>
            </div>

            <div class="header-right">
                <a href="/" class="btn-back-site">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                        <polyline points="15 3 21 3 21 9" />
                        <line x1="10" y1="14" x2="21" y2="3" />
                    </svg>
                    На сайт
                </a>
            </div>
        </header>
        <%- include('../partials/adminSidebar') %>

            <main class="admin-main">

                <div class="admin-content">

                    <section class="tabs-section">
                        <button class="tab-btn active" data-tab="users">Пользователи</button>
                        <button class="tab-btn" data-tab="banned">Заблокированные</button>
                    </section>

                    <!-- USERS -->
                    <section class="tab-content active" id="users-tab">
                        <div class="table-container">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Пользователь</th>
                                        <th>Роль</th>
                                        <th>Регистрация</th>
                                        <th>Действия</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% users.forEach(user=> { %>
                                        <tr>
                                            <td>
                                                <div class="author-cell">
                                                    <div class="author-avatar">
                                                        <%= user.username[0] %>
                                                    </div>
                                                    <span>
                                                        <%= user.username %>
                                                    </span>
                                                </div>
                                            </td>

                                            <td>
                                                <span class="role-badge <%= user.role %>">
                                                    <%= user.role_name %>
                                                </span>
                                            </td>

                                            <td>
                                                <%= new Date(user.created_at).toLocaleString('ru-RU')%>
                                            </td>

                                            <td class="action-buttons">
                                                <form method="POST" action="/admin/createModer"
                                                    onsubmit="return confirm('Точно назначить роль?');">
                                                    <input type="hidden" name="user_id" value="<%= user.id %>">
                                                    <button class="btn btn-danger">Модератор</button>
                                                </form>

                                                <form method="POST" action="/admin/createAdmin"
                                                    onsubmit="return confirm('Точно назначить роль?');">
                                                    <input type="hidden" name="user_id" value="<%= user.id %>">
                                                    <button class="btn btn-danger">Админ</button>
                                                </form>

                                               <form method="POST" action="/admin/nowUser"
                                                    onsubmit="return confirm('Точно снять роль?');">
                                                    <input type="hidden" name="user_id" value="<%= user.id %>">
                                                    <button class="btn btn-danger">Снять роль</button>
                                                </form>

                                                <form method="POST" action="/admin/block"
                                                    onsubmit="return confirm('Точно заблокировать?');">
                                                    <input type="hidden" name="user_id" value="<%= user.id %>">
                                                    <button class="btn btn-danger">Блокировка</button>
                                                </form>
                                            </td>
                                        </tr>
                                        <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </section>

                    <!-- BANNED -->
                    <section class="tab-content" id="banned-tab">
                        <div class="table-container">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Пользователь</th>
                                        <th>Причина</th>
                                        <th>Дата</th>
                                        <th>Модератор</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% bannedUsers.forEach(user=> { %>
                                        <tr>
                                            <td>
                                                <div class="author-cell">
                                                    <div class="author-avatar">
                                                        <%= user.username[0] %>
                                                    </div>
                                                    <span>
                                                        <%= user.username %>
                                                    </span>
                                                </div>
                                            </td>
                                            <td>
                                                <%= user.reason %>
                                            </td>
                                            <td>
                                                <%= new Date(user.created_at).toLocaleString('ru-RU') %>
                                            </td>
                                            <td>
                                                <%= user.blocked_by_username %>
                                            </td>
                                            <td>
                                               <form method="POST" action="/admin/unblock"
                                                    onsubmit="return confirm('Точно разблокировать?');">
                                                    <input type="hidden" name="user_id" value="<%= user.user_id %>">
                                                    <button class="btn btn-danger">Разблокировать</button>
                                                </form>
                                            </td>
                                        </tr>
                                        <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </section>

                </div>
            </main>
            <script>
                document.querySelectorAll('.tab-btn').forEach(btn => {
                    btn.addEventListener('click', () => {
                        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
                        document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));

                        btn.classList.add('active');

                        document.getElementById(btn.dataset.tab + '-tab').classList.add('active');
                    });
                });

                function setModerator(id) {
                    console.log('set moderator', id);
                }

                function setAdmin(id) {
                    console.log('set admin', id);
                }

                function removeRole(id) {
                    console.log('remove role', id);
                }

                function banUser(id) {
                    console.log('ban', id);
                }

                function unbanUser(id) {
                    console.log('unban', id);
                }
            </script>