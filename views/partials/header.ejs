<!-- Header -->
  <header class="header">
    <div class="header-inner">
      <a href="/errors/secret" class="logo">
        <span class="logo-icon">&#9733;</span>
        <span class="logo-text">StarRail<span class="logo-accent">Station</span></span>
      </a>
      
      <nav class="nav">
        <a href="/" class="nav-link">Главная</a>
        <a href="/topics" class="nav-link">Топики</a>
        <a href="/cat" class="nav-link">Категории</a>
      </nav>

      <div class="header-actions">

        <% if (user){ %>

<div class="notification-wrapper">

    <button class="notification-btn" id="notifBtn">

        <svg width="20" height="20" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
        </svg>

        <span class="notification-dot"></span>

    </button>

    <div class="notifications-dropdown" id="notifDropdown">

        <div class="notifications-header">
            Уведомления
        </div>

        <div class="notifications-list">

    <% notifications.forEach(notif => { %>

        <div class="notification-item <%= notif.is_read == 0 ? 'unread' : '' %>">

            <div class="notif-icon">

                <% if (notif.type === 'like') { %>
                    ❤
                <% } %>

                <% if (notif.type === 'reply') { %>
                    💬
                <% } %>

                <% if (notif.type === 'mention') { %>
                    @
                <% } %>

            </div>

            <div class="notif-content">

                <div class="notif-text">

                    <% if (notif.type === 'like') { %>

                        <strong>
                            <%= notif.username %>
                        </strong>

                        лайкнул ваш пост

                    <% } %>

                    <% if (notif.type === 'reply') { %>

                        <strong>
                            <%= notif.username %>
                        </strong>

                        ответил в вашей теме

                    <% } %>

                    <% if (notif.type === 'mention') { %>

                        <strong>
                            <%= notif.username %>
                        </strong>

                        упомянул вас

                    <% } %>

                </div>

                <div class="notif-time">
                    <%= new Date(notif.created_at).toLocaleString("ru-RU") %>
                </div>

            </div>

        </div>

    <% }) %>

</div>

    </div>

</div>

<% } %>
        <form method="GET" action="/searchResults" class="search-form">
                    <input type="text" name="search" class="search-input" placeholder="Поиск по темам...">
                  </form>

  <% if (!user) { %>

    <button onclick="location.href='/login'" class="btn btn-ghost">Войти</button>
    <button onclick="location.href='/reg'" class="btn btn-primary">Регистрация</button>
    
  
  <% } else { %>

      <% 
      let link = "/user/lk";
      if (user.role== 1) link = "/admin/dashboard";
      else if (user.role == 3) link = "/admin/content";
      %>
    <a href="<%= link %>" class="btn btn-primary" style="display:flex;align-items:center;gap:8px;">
      <span style="width:24px;height:24px;border-radius:50%;background:#6c5ce7;display:inline-flex;align-items:center;justify-content:center;color:#fff;font-size:12px;">
        <%= userData.username[0].toUpperCase() %>
      </span>
     <%= userData.username %>
    </a>

    <button onclick="location.href='/logout'" class="btn btn-ghost">
      Выйти
    </button>

  <% } %>
</div>
  </header>