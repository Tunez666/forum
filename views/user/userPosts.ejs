<%- include('../partials/head') %>
    <%- include('../partials/header') %>

        <div class="user-posts-page">

            <!-- background -->
            <div class="bg-layer">
                <div class="orb orb-1"></div>
                <div class="orb orb-2"></div>
                <div class="orb orb-3"></div>
                <div class="grid-lines"></div>
            </div>

            <div class="user-posts-container">

                <!-- header -->
                <div class="page-header">

                    <div>
                        <h1 class="page-title">
                            Мои сообщения
                        </h1>

                        <p class="page-subtitle">
                            Все комментарии и ответы, которые вы оставляли
                        </p>
                    </div>

                    <a href="/user/lk" class="btn btn-ghost">
                        ← Профиль
                    </a>

                </div>

                <!-- stats -->
                <div class="stats-row">

                    <div class="stat-card">
                        <div class="stat-label">Всего сообщений</div>
                        <div class="stat-value">
                            <%= postsCount %>
                        </div>
                    </div>

                </div>

                <!-- list -->
                <div class="posts-list">

                    <% if (postsCount> 0) { %>

                        <% postsData.forEach(post=> { %>

                            <div class="post-card">

                                <!-- left -->
                                <div class="post-main">

                                    <a href="/topic/<%= post.topic_id %>" class="post-topic">
                                        <%= post.topic_title %>
                                    </a>

                                    <div class="post-content">
                                        <%= post.content %>
                                    </div>

                                    <div class="post-actions">

                                        <a href="/topic/<%= post.topic_id %>#post-<%= post.id %>" class="btn btn-ghost">
                                            Открыть
                                        </a>

                                        <form method="POST" action="/user/delete"
                                                    onsubmit="return confirm('Точно удалить?');">
                                                    <input type="hidden" name="post_id" value="<%= post.post_id %>">
                                                    <button type="submit" class="btn btn-danger">Удалить</button>
                                                </form>

                                    </div>

                                </div>

                                <!-- right meta -->
                                <div class="post-meta">

                                    <div class="meta-badge">
                                        💬 Сообщение
                                    </div>

                                    <div class="meta-date">
                                        <%= new Date(post.created_at).toLocaleString('ru-RU') %>
                                    </div>

                                </div>

                            </div>

                            <% }) %>

                                <% } else { %>

                                    <div class="empty-state">

                                        <div class="empty-title">
                                            Здесь пока пусто
                                        </div>

                                        <div class="empty-text">
                                            Вы ещё не оставляли сообщений
                                        </div>

                                        <a href="/" class="btn btn-primary">
                                            Перейти на форум
                                        </a>

                                    </div>

                                    <% } %>

                </div>

                <div class="pagination">

                    <% if (currentPage> 1) { %>
                        <a href="?page=<%= currentPage - 1 %>" class="page-btn">
                            ← Назад
                        </a>
                        <% } %>

                            <% for (let i=1; i <=totalPages; i++) { %>

                                <a href="?page=<%= i %>" class="page-btn <%= i === currentPage ? 'active' : '' %>">
                                    <%= i %>
                                </a>

                                <% } %>

                                    <% if (currentPage < totalPages) { %>
                                        <a href="?page=<%= currentPage + 1 %>" class="page-btn">
                                            Вперёд →
                                        </a>
                                        <% } %>

                </div>

             

            </div>

        </div>