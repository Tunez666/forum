<%- include('../partials/head') %>

    <body>
        <!-- Animated Background -->
        <div class="animated-bg">
            <div class="grid-overlay"></div>
            <div class="orb orb-1"></div>
            <div class="orb orb-2"></div>
        </div>

        <%- include('../partials/header') %>

            <main class="profile-page">
                <div class="profile-container">

                    <!-- Main Content -->
                    <div class="profile-content">

                        <!-- GENERAL -->
                        <section id="general" class="profile-tab active">
                            <div class="profile-section">

                                <div class="section-header">
                                    <h2 class="section-title">
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2">
                                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                            <circle cx="12" cy="7" r="4" />
                                        </svg>
                                        Профиль пользователя  <%= userData.username %>
                                    </h2>
                                </div>

                                <div class="section-card">

                                    <!-- AVATAR -->
                                    <div class="avatar-upload-section">

                                        <div class="form-row">

                                            <div class="avatar-preview">
                                                <img src="/img/avas/<%= userData.avatarca %>" alt="Аватар">
                                            </div>

                                            <div class="avatar-info">
                                                <h4>
                                                    <%= userData.username %>
                                                </h4>
                                                <p>UID: <%= userData.uid || 'Не указан' %>
                                                </p>
                                            </div>

                                        </div>

                                    </div>

                                    <!-- INFO -->
                                    <div class="form-group">
                                        <label>О себе</label>
                                        <div class="form-textarea readonly">
                                            <%= userData.about || 'Пользователь ничего не написал' %>
                                        </div>
                                    </div>
                                    <!-- STATS -->
                                    <div class="section-header">
                                        <h2 class="section-title">
                                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2">
                                                <line x1="18" y1="20" x2="18" y2="10" />
                                                <line x1="12" y1="20" x2="12" y2="4" />
                                                <line x1="6" y1="20" x2="6" y2="14" />
                                            </svg>
                                            Статистика активности
                                        </h2>
                                    </div>
                                    <div class="stats-grid">
                                        <div class="stat-card">
                                            <div class="stat-icon purple">
                                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                                                    stroke="currentColor" stroke-width="2">
                                                    <path
                                                        d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                                                </svg>
                                            </div>
                                            <div class="stat-content">
                                                <span class="stat-value">
                                                    <%= postsCount %>
                                                </span>
                                                <span class="stat-label">Сообщений</span>
                                            </div>
                                        </div>
                                        <div class="stat-card">
                                            <div class="stat-icon pink">
                                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                                                    stroke="currentColor" stroke-width="2">
                                                    <path
                                                        d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                                    <polyline points="14 2 14 8 20 8" />
                                                </svg>
                                            </div>
                                            <div class="stat-content">
                                                <span class="stat-value">
                                                    <%= topicsCount %>
                                                </span>
                                                <span class="stat-label">Тем создано</span>
                                            </div>
                                        </div>
                                        <div class="stat-card">
                                            <div class="stat-icon cyan">
                                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                                                    stroke="currentColor" stroke-width="2">
                                                    <path
                                                        d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                                                </svg>
                                            </div>
                                            <div class="stat-content">
                                                <span class="stat-value">
                                                    <%= likesCount %>
                                                </span>
                                                <span class="stat-label">Получено лайков</span>
                                            </div>
                                        </div>
                                        <div class="stat-card">
                                            <div class="stat-icon gold">
                                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                                                    stroke="currentColor" stroke-width="2">
                                                    <polygon
                                                        points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                                                </svg>
                                            </div>
                                            <div class="stat-content">
                                                <span class="stat-value">
                                                    <%= rep %>
                                                </span>
                                                <span class="stat-label">Репутация</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>


                            </div>
                        </section>




                    </div>
                </div>
            </main>

    </body>

    </html>