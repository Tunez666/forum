<%- include('partials/head') %>
    <%- include('partials/header') %>
        <div class="topic-view">

            <!-- Хедер темы -->
            <div class="topic-view__header">
                <h1 class="topic-view__title">
                    <%= topic.title %>
                </h1>

                <h3 class="topic-view__title">
                    <%= topic.description %>
                </h3>

                <div class="topic-view__meta">
                    <span>Автор: </span>
                    <span>
                        <%= topic.author_name %>
                    </span>
                </div>
            </div>

            <!-- Список постов -->
            <div class="topic-view__posts">

                <% posts.forEach(post=> { %>
                    <div class="topic-view__post">

                        <!-- Юзер -->

                        <div class="topic-view__user">

                            <a href="/user/prLk/<%= post.author_id %>" class="topic-view__user-link">

                                <img src="/img/avas/<%= post.avatarca %>" class="topic-view__avatar">

                                <div class="topic-view__username">
                                    <%= post.username %>
                                </div>

                            </a>

                        </div>


                        <!-- Контент -->
                        <div class="topic-view__content">

                            <div class="topic-view__text">
                                <%= post.content %>
                            </div>



                            <div class="topic-view__footer">
                                <span class="topic-view__date">
                                    <%= new Date(post.created_at).toLocaleString() %>

                                </span>



                                <div class="topic-view__actions">

                                        <% if (post.author_id === userId) { %>
                                    <button class="topic-view__btn report-btn" onclick='openRed(<%= post.id %>, `<%- post.content %>` )'>
                                        Редактировать
                                    </button>
                                        <% } %>

                                        <% if (post.author_id === userId) { %>
                                      <form method="POST" action="/delete/<%= topicId %>"
                                                    onsubmit="return confirm('Точно удалить?');">
                                                    <input type="hidden" name="post_id" value="<%= post.id %>">
                                                    <button class="topic-view__btn like-btn">Удалить</button>
                                                </form>
                                        <% } %>

                                    <button class="topic-view__btn report-btn" onclick="openReport(<%= post.id %>)">
                                        Пожаловаться
                                    </button>


                                    <button class="topic-view__btn like-btn <%= post.is_liked ? 'liked' : '' %>"
                                        data-post-id="<%= post.id %>">
                                        🖤 <span class="like-count">
                                            <%= post.likes_count %>
                                        </span>
                                    </button>
                                </div>
                            </div>

                        </div>

                    </div>
                    <% }) %>
            </div>
            <div class="topic-view__reply">

                <h3 class="topic-view__reply-title">Написать ответ</h3>

                <form method="POST" action="/reply/<%= topicId %>">

                    <textarea name="content" class="topic-view__textarea" placeholder="Напиши что-нибудь..." required
                        minlength="3"></textarea>
                    <% if (typeof error !=='undefined' && error==='empty' ) { %>
                        <div class="error">Сообщение не может быть пустым</div>
                        <% } %>

                            <button type="submit" class="topic-view__submit">
                                Отправить
                            </button>

                </form>

            </div>
            <div id="last"></div>
        </div>
        <div class="modal-overlay" id="report-modal" onclick="closeModalOnOverlay(reason)">
            <div class="modal-content">
                <div class="modal-header">
                    <h3 id="modal-title">Пожаловаться</h3>
                    <button class="modal-close" onclick="closeReport()">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <line x1="18" y1="6" x2="6" y2="18" />
                            <line x1="6" y1="6" x2="18" y2="18" />
                        </svg>
                    </button>
                </div>
                <form id="report" method='POST' action='/report/<%= topicId %>'>
                    <input type="hidden" id="report-post-id" name="post_id">
                    <div class="form-group">
                        <label for="reasons">Причина жалобы</label>
                        <select id="reason-list" name="report_id" class="form-input">

                            <% reports.forEach(rep=> { %>
                                <option value="<%= rep.id %>">
                                    <%= rep.name %>
                                </option>
                                <% }) %>

                        </select>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <polyline points="20 6 9 17 4 12" />
                            </svg>
                            <span id="modal-submit-text">Отправить жалобу</span>
                        </button>
                        <button type="button" class="btn btn-secondary" onclick="closeReport()">
                            Отмена
                        </button>
                    </div>
                </form>
            </div>
        </div>
            <!-- Редактирование поста -->
        <div class="modal-overlay" id="edit-modal" onclick="closeModalOnOverlay(event)">
            <div class="modal-content">
                <div class="modal-header">
                    <h3 id="modal-title">Редактировать пост</h3>
                    <button class="modal-close" onclick="closeReport()">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <line x1="18" y1="6" x2="6" y2="18" />
                            <line x1="6" y1="6" x2="18" y2="18" />
                        </svg>
                    </button>
                </div>
                <form id="edit" method='POST' action='/edit/<%= topicId %>'>
                    <input type="hidden" id="edit-post-id" name="post_id">
                    <div class="form-group">
                        <textarea
    name="content"
    id="edit-content"
    class="topic-view__textarea"
></textarea>
                        
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <polyline points="20 6 9 17 4 12" />
                            </svg>
                            <span id="modal-submit-text">Готово</span>
                        </button>
                        <button type="button" class="btn btn-secondary" onclick="closeEdit()">
                            Отмена
                        </button>
                    </div>
                </form>
            </div>
        </div>
        <script>
            document.addEventListener("DOMContentLoaded", () => {
                document.querySelectorAll(".like-btn").forEach(btn => {
                    btn.addEventListener("click", async () => {

                        const postId = btn.dataset.postId;

                        if (!postId) {
                            console.log("NO POST ID");
                            return;
                        }

                        const res = await fetch("/like", {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json"
                            },
                            body: JSON.stringify({ postId })
                        });

                        let data;
                        try {
                            data = await res.json();
                        } catch (e) {
                            console.log("INVALID JSON RESPONSE");
                            return;
                        }

                        // 💥 ВАЖНО: сначала проверяем авторизацию
                        if (!res.ok) {
                            if (data.error === "NOT_AUTH") {
                                window.location.href = data.redirect;
                                return;
                            }

                            console.log("LIKE ERROR", data);
                            return;
                        }

                        const countEl = btn.querySelector(".like-count");
                        let count = parseInt(countEl.textContent || "0");

                        if (data.liked) {
                            btn.classList.add("liked");
                            count++;
                        } else {
                            btn.classList.remove("liked");
                            count--;
                        }

                        countEl.textContent = count;
                    });
                });
            });

            // ===============================
            // OPEN CREATE MODAL
            // ===============================
            function openReport(postId) {
                const modal = document.getElementById('report-modal');
                const input = document.getElementById('report-post-id');

                input.value = postId;

                modal.classList.add('active');
                document.body.style.overflow = 'hidden';
            }

            // ===============================
            // CLOSE CREATE MODAL
            // ===============================
            function closeReport() {
                const modal = document.getElementById('report-modal');
                modal.classList.remove('active');
                document.body.style.overflow = '';
            }

            // ===============================
            // CLOSE BY OVERLAY CLICK
            // ===============================
            function closeModalOnOverlayEdit(event) {
                if (event.target.id === 'report-modal') {
                    closeReport();
                }
            }


function openRed(postId, content) {

    const modal = document.getElementById('edit-modal');

    const input = document.getElementById('edit-post-id');

    const textarea = document.getElementById('edit-content');

    input.value = postId;

    textarea.value = content;

    modal.classList.add('active');

    document.body.style.overflow = 'hidden';
}

            function closeEdit() {

    const modal = document.getElementById('edit-modal');

    modal.classList.remove('active');

    document.body.style.overflow = '';
}

            // ===============================
            // CLOSE BY OVERLAY CLICK
            // ===============================
            function closeModalOnOverlayEdit(event) {
                if (event.target.id === 'report-modal') {
                    closeReport();
                }
            }
        </script>
        <%- include('partials/footer') %>