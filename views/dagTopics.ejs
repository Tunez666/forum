<%- include('partials/head') %>

  <body>
    <!-- Background -->
    <div class="bg-layer">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="orb orb-3"></div>
      <div class="grid-lines"></div>
    </div>

    <%- include('partials/header') %>

      <main class="topics-page">
        <div class="topics-container">
          <!-- Page Header -->
          <div class="topics-page-header">
            <div class="page-title-row">
              <h1 class="page-title">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                </svg>
                Топики в <%= name.name %>
              </h1>
            </div>

            <!-- Filters -->
            <div class="topics-filters">

              <div class="filter-group">
                <label class="filter-label">Фильтр</label>
                <div class="section-tabs">
                  <a href="/dagTopics/<%= categoryId %>?sort=new" class="tab <%= sort === 'new' ? 'active' : '' %>">Новые</a>
                  <a href="/dagTopics/<%= categoryId %>?sort=popular" class="tab <%= sort === 'popular' ? 'active' : '' %>">Популярные</a>
                  <a href="/dagTopics/<%= categoryId %>?sort=empty" class="tab <%= sort === 'empty' ? 'active' : '' %>">Не популярные</a>
                </div>
              </div>
              <div class="filter-group search-group">
                <label class="filter-label">Поиск</label>
                <div class="search-input-wrapper">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                  </svg>
                  <form method="GET" action="/searchResults" class="search-form">
                    <input type="text" name="search" class="search-input" placeholder="Поиск по темам...">
                  </form>
                </div>
              </div>
            </div>
          </div>
        

          <!-- Topics List -->
          <div class="topics-list-container">
            <div class="topics-list-header">
              <span class="header-cell topic-cell">Название</span>
              <span class="header-cell category-cell"> Постов </span>
              <span class="header-cell activity-cell">Автор</span>
              <span class="header-cell activity-cell">Дата создания</span>
            </div>

            <div class="topics-list-body">

              <!-- Regular Topics -->
              <% subTopics.forEach(sub=> { %>
                <div class="topic-list-row">
                  <div class="topic-cell">
                    <div class="topic-avatar">
                      <div class="avatar-circle" style="--hue: 270;">
                        <%= sub.title[0].toUpperCase() %>
                      </div>
                    </div>
                    <div class="topic-main-info">
                      <a href="/topic/<%= sub.id %>" class="topic-title-text">
                        <%= sub.title %>
                      </a>
                      <div class="topic-meta-row">
                        <div class="topic-badges">
                          <span class="topic-category-badge" style="--cat-color: #f755a6;">
                            <%= sub.description %>
                          </span>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="category-cell">
                    <span class="category-tag" style="--cat-color: #f59e0b;">
                      <%= sub.posts_count %>
                    </span>
                  </div>
                  <div class="replies-cell">
                    <span class="avatar-circle" style="--hue: 285;">
                      <%= sub.author_name[0].toUpperCase() %>
                    </span>
                  </div>
                  <div class="activity-cell">

                    <span class="category-tag" style="--cat-color: #0bf565;">
                      <%= new Date(sub.created_at).toLocaleString('ru-RU') %>
                    </span>
                    <div class="last-activity">

                    </div>
                  </div>
                  <div class="activity-cell">
                    <div class="last-activity">

                    </div>
                  </div>


                </div>
                <% }) %>
            </div>
          </div>

          <!-- Pagination -->
          <div class="pagination-container">
            <div class="pagination-info">

            </div>
            <div class="pagination-controls">

              <% if (page> 1) { %>
                <a class="pagination-btn"
                  href="/dagTopics/<%= categoryId %>?page=<%= page - 1 %>&sort=<%= sort %>&category=<%= categoryId || '' %>">
                  ←
                </a>
                <% } %>

                  <% for (let i=1; i <=totalPages; i++) { %>
                    <a class="pagination-btn <%= page == i ? 'active' : '' %>"
                      href="/dagTopics/<%= categoryId %>?page=<%= i %>&sort=<%= sort %>&category=<%= categoryId || '' %>">
                      <%= i %>
                    </a>
                    <% } %>

                      <% if (page < totalPages) { %>
                        <a class="pagination-btn"
                          href="/dagTopics/<%= categoryId %>?page=<%= page + 1 %>&sort=<%= sort %>&category=<%= categoryId || '' %>">
                          →
                        </a>
                        <% } %>

            </div>
            <div class="per-page-selector">

            </div>
          </div>
        </div>
        </div>


        <script>
          function applyFilter(select) {
            const category = select.value;
            const url = new URL(window.location.href);

            if (category) {
              url.searchParams.set("category", category);
            } else {
              url.searchParams.delete("category");
            }

            window.location.href = url.toString();
          }
        </script>

        <%- include('partials/footer') %>