<%- include('./partials/head') %>

<body>

<%- include('./partials/header') %>

<main class="contact-page">
    <div class="contact-container">

        <div class="contact-hero">
            <h1>Связаться с нами</h1>

            <p>
                Если у вас возникли вопросы, предложения или вы нашли ошибку —
                свяжитесь с администрацией форума удобным способом.
            </p>
        </div>

        <div class="contact-info">

            <div class="contact-card">
                <h3>Telegram</h3>

                <p>
                    @your_forum_support
                </p>

                <a href="https://t.me/hsr_forum_support"
                   target="_blank"
                   class="contact-link">
                    Написать
                </a>
            </div>

            <div class="contact-card">
                <h3>VK</h3>

                <p>
                    vk.com/hsr_forum
                </p>

                <a href="https://vk.com/hsr_forum"
                   target="_blank"
                   class="contact-link">
                    Открыть сообщество
                </a>
            </div>

            <div class="contact-card">
                <h3>Email</h3>

                <p>
                    support@forum.local
                </p>

                <a href="mailto:support@forum.local"
                   class="contact-link">
                    Отправить письмо
                </a>
            </div>

            <div class="contact-card">
                <h3>Время ответа</h3>

                <p>
                    Обычно отвечаем в течение 24–48 часов
                </p>
            </div>

        </div>

    </div>
</main>

<%- include('partials/footer') %>